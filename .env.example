# 실제 데이터 폴더의 절대 경로 (raw/, csv/, prepared/ 포함)
ROTEC_DATA_DIR=/absolute/path/to/한국로텍_서버용
# 편집한 노트북과 분석 결과를 보관할 폴더. 시작 전에 생성합니다.
ROTEC_OUTPUT_DIR=./server-output
ROTEC_UID=1000
ROTEC_GID=1000
ROTEC_BIND_IP=127.0.0.1
ROTEC_PORT=8890
# python3 -c 'import secrets; print(secrets.token_hex(32))' 로 생성합니다.
JUPYTER_TOKEN=
# ngrok 프로필 사용 시 계정 authtoken을 입력합니다. 공개 Git에 올리지 않습니다.
NGROK_AUTHTOKEN=
